# 选择器工程配置 —— 与导航固件基线对齐
#
# [实测 2026-11-19] 第一版选择器只写了 Flash/PSRAM/LVGL 少量配置，烧进去是「白屏 + 串口 0 字节」。
# 两个缺失项：
#   1) CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG —— 缺了它 console 走 UART0（板上没引出），USB 上一个字都抓不到；
#   2) CPU 240 MHz / Data Cache 64 KB / SPIRAM FETCH_INSTRUCTIONS —— BSP 的 QSPI 刷屏路径按 240 MHz
#      基线调的，160 MHz 下 CO5300 初始化就过不去，表现即白屏。
# 因此这里整段照抄导航的板级基线，只把分区表名改成双程序表。

# ---- Flash / PSRAM ----
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_dual.csv"

# 三程序共存：开启 OTA rollback，第三方程序（MotoNav）没有回跳逻辑，
# 由 bootloader 保证"只跑一个上电周期"——它从不 mark valid，下次复位即回退到 factory（选择器）
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_ALLOW_NOINIT_SEG_EXTERNAL_MEMORY=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# ---- FreeRTOS ----
CONFIG_FREERTOS_HZ=1000

# ---- LVGL 9.5 ----
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_OBJ_STYLE_CACHE=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM=n
CONFIG_LV_USE_FONT_COMPRESSED=y
CONFIG_LV_USE_SYSMON=n
CONFIG_LV_USE_PERF_MONITOR=n
CONFIG_LV_USE_MEM_MONITOR=n
# 选择器只显示一张静态底图，用不到 LVGL 自带示例；不关要白编约 800 个 lv_example_*.c
CONFIG_LV_BUILD_EXAMPLES=n

# ---- 无线：选择器不需要，明确关掉省 IRAM ----
CONFIG_ESP_WIFI_ENABLED=n
CONFIG_BT_ENABLED=n

# ---- 看门狗：与导航一致 ----
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
