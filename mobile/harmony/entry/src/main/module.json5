{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone",
      "tablet"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    // 说明：LOCATION_IN_BACKGROUND / READ_HEALTH_DATA 属于受限权限（ACL），
    // 用 DevEco 自动签名会直接构建失败；必须先在 AGC 后台申请到 ACL 再放开下面两行。
    // 未放开时：锁屏后系统会冻结定位，板端 30s 校准时断时续——这是可接受的过渡状态。
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET"
      },
      {
        "name": "ohos.permission.GET_NETWORK_INFO"
      },
      {
        "name": "ohos.permission.LOCATION",
        "reason": "$string:reason_location",
        "usedScene": {
          "abilities": ["EntryAbility"],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.APPROXIMATELY_LOCATION",
        "reason": "$string:reason_location",
        "usedScene": {
          "abilities": ["EntryAbility"],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.KEEP_BACKGROUND_RUNNING"
      },
      {
        "name": "ohos.permission.ACTIVITY_MOTION",
        "reason": "$string:reason_motion",
        "usedScene": {
          "abilities": ["EntryAbility"],
          "when": "inuse"
        }
      },
      {
        // BLE 主传输：扫描/连接/读写板端 GATT 都需要它
        "name": "ohos.permission.ACCESS_BLUETOOTH",
        "reason": "$string:reason_bluetooth",
        "usedScene": {
          "abilities": ["EntryAbility"],
          "when": "always"
        }
      }
      // ACL 权限，申请到后再放开：
      // { "name": "ohos.permission.LOCATION_IN_BACKGROUND",
      //   "reason": "$string:reason_location_bg",
      //   "usedScene": { "abilities": ["EntryAbility"], "when": "always" } },
      // { "name": "ohos.permission.READ_HEALTH_DATA" }
    ],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:icon",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "backgroundModes": ["location", "taskKeeping"],
        "skills": [
          {
            "entities": ["entity.system.home"],
            "actions": ["action.system.home"]
          }
        ]
      }
    ]
  }
}
